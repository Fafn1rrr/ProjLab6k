# Nokopējiet šo failu kā .env un norādiet savus PostgreSQL pieejas datus.
# Formāts: postgresql+psycopg://LIETOTĀJS:PAROLE@HOSTS:PORTS/DATUBĀZE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/drukas_planosana

# Sesiju un paziņojumu parakstīšanai. Serverī nomainiet uz garu nejaušu virkni.
SECRET_KEY=dev-only-change-me
